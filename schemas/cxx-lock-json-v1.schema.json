{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectDependencies",
    "developmentTools"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "projectDependencies": {
      "type": "object",
      "description": "Reserved for build dependency resolution; existing contents are preserved.",
      "additionalProperties": true
    },
    "developmentTools": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Exact upstream release; release identity is validated by the tool adapter."
          }
        }
      }
    }
  }
}
